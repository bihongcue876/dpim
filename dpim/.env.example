#       "base_url": "https://api.siliconflow.cn/v1",
#       "api_key": "sk-xxxx",
#       "models": ["Qwen/Qwen3.5-4B", "deepseek-ai/DeepSeek-V4-Flash"],
#       "timeout": 666,
#       "max_tokens": 32000,
#       "thinking_budget": 4096,
#       "thinking_style": "top_level",
#       "structured_mode": "md_json"
#     }
#   },
