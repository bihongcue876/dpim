# DPIM 配置示例 — 复制为 .env 使用（.env 已 gitignore，不进版本库）
# 绝大多数配置项都有内置默认值，完整清单与说明见 dpim/core/config.py 和 share/protocol.md。
# 密钥 / BYOK 供应商 / 模型路由等结构化配置放在同目录 dpim.json（同样 gitignore，结构见 protocol.md）。

# 存储路径
DPIM_MEMORY_DB_PATH=./data/memory.db
DPIM_GRAPH_JSON_PATH=./data/graph.json

# 日志级别：DEBUG | INFO | WARNING | ERROR
DPIM_LOG_LEVEL=INFO

# ── 安全（部署到服务器时设置；本地默认关闭）──
# API 访问认证：非空时所有端点要求 X-API-Key 请求头匹配，空 = 禁用认证（本地默认）
# DPIM_API_KEY=change-me-to-a-long-random-secret
# AI 调用日志全文开关：false 时 GET /agent/logs 忽略 full 参数（日志含事件原文，防泄露）
# DPIM_AGENT_LOGS_FULL=true