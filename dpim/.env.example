# DPIM 配置示例 — 复制为 .env 使用（.env 已被 gitignore，不进版本库）
# 绝大多数配置项都有内置默认值，无需写入 .env。
# 密钥 / 供应商(BYOK) / 模型路由 等结构化配置请放在 dpim.json（同目录，同样被 gitignore）。

# 存储路径
DPIM_MEMORY_DB_PATH=./data/memory.db
DPIM_GRAPH_JSON_PATH=./data/graph.json

# 日志级别：DEBUG | INFO | WARNING | ERROR
DPIM_LOG_LEVEL=INFO

# ── 安全（部署到服务器时设置；本地默认关闭）──
# API 访问认证：非空时所有端点要求 X-API-Key 请求头匹配，空 = 禁用认证（本地默认）
# DPIM_API_KEY=change-me-to-a-long-random-secret
# AI 调用日志全文开关：false 时 GET /agent/logs 忽略 full 参数（日志含事件原文，防泄露）
# DPIM_AGENT_LOGS_FULL=true

# ── 其他可覆盖项（均有默认值，一般无需设置）──
# DPIM_LLM_BASE_URL / DPIM_LLM_API_KEY / DPIM_LLM_MODEL_NAME / DPIM_LLM_TIMEOUT
# DPIM_RRF_K / DPIM_JACCARD_THRESHOLD / DPIM_MAX_GRAPH_HOPS
# DPIM_HEALTH_CHECK_INTERVAL / DPIM_HEALTH_CHECK_TIMEOUT
# DPIM_COMPENSATE_BATCH_SIZE / DPIM_COMPENSATE_CHECK_INTERVAL
# DPIM_MAX_RAW_CONTENT / DPIM_LLM_STRUCTURED_MODE
# 完整清单与说明见 dpim/core/config.py（Settings.__init__）和 share/protocol.md

# dpim.json 示例结构（复制到同目录 dpim.json，供 BYOK 供应商注册）：
# {
#   "active_provider": "siliconflow",
#   "active_model": "deepseek-ai/DeepSeek-V4-Flash",
#   "providers": {
