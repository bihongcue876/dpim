# DPIM 配置示例 — 复制为 .env 使用（.env 已 gitignore，不进版本库）
#
# .env 现在只承载两类内容：
#   1) 部署级安全开关（下方安全段）
#   2) 少量部署覆盖（如 DPIM_PROVIDERS 注册表、DPIM_MEMORY_DB_PATH 等临时覆盖；
#      注意：env 显式设置会压制 dpim.json 的同名项）
#
# 日常配置（提供商/密钥/模型路由/存储路径/日志级别等）请用 WebUI 配置页，
# 全部持久化在 dpim.json（同样 gitignore，结构见 protocol.md），重启保留。
# 完整配置清单见 dpim/core/config.py 和 share/protocol.md。

# ── 运行配置的落点（v1.36 起）──
# 凡日常可调的项（检索与护栏 / 健康检查与补偿 / 图维护自动化 / 本地日志与 WAL / BYOK 提供商 …）
# 一律落在 dpim.json，请从 WebUI「维护 → 运行配置」编辑；改动先是草稿，点「提交配置」才写回。
# 本文件里的环境变量是**部署覆盖**：env 优先于 dpim.json，被覆盖的项在界面上标为
# 「由环境变量 DPIM_X 决定（界面不可改）」并置灰；PUT /settings 会把它列进 ignored_by_env 点名回报。
# 有意**只认 env**（界面不提供）的几项，各有硬理由：
#   DPIM_API_KEY          访问认证密钥——不能让 API 读回或改写
#   DPIM_LOG_DIR          换日志目录要重开文件句柄，只能在启动时定
#   DPIM_LLM_TIMEOUT / DPIM_LLM_MAX_TOKENS / DPIM_LLM_ENABLE_THINKING / DPIM_LLM_THINKING_BUDGET
#                         LLM 全局调优兜底（每个 provider 条目自带这四项），属纯 env
# 读取链与完整配置表见 dpim/README.md §5「配置方式」。

# ── 安全（部署到服务器时设置；本地默认关闭）──
# API 访问认证：非空时所有端点要求 X-API-Key 请求头匹配，空 = 禁用认证（本地默认）
# DPIM_API_KEY=change-me-to-a-long-random-secret
# AI 调用日志全文开关：false 时 GET /agent/logs 忽略 full 参数（日志含事件原文，防泄露）
# DPIM_AGENT_LOGS_FULL=true

# ── 本地日志（前后端分文件，按天轮转；默认 <dpim>/logs）──
# 日志目录：backend-YYYY-MM-DD.log / frontend-YYYY-MM-DD.log 两份分开存放
# DPIM_LOG_DIR=./logs
# 保留天数（0 = 不清理旧文件）
# DPIM_LOG_RETENTION_DAYS=14
# 额外输出 JSONL（程序读；人读用默认文本格式）
# DPIM_LOG_JSONL=false
# 翻看方式：直接打开日志目录；或本地 CLI `python main.py logs --help`

# ── AI 身份（BYOK）与全局调优兜底 ──
# 【重要】已无任何内置身份默认值：没有默认 base_url、没有默认 api_key、没有默认模型名。
#   （v1.34 前 LLM_BASE_URL 默认 http://localhost:11434/v1、LLM_MODEL_NAME 默认 llama3:8b，
#    任何未配置的部署都静默指向并不存在的本地 llama，而界面看不出「其实没配」。）
# AI 身份（base_url / api_key / model）现在**只存在于 provider 条目**：原先与 provider 平行的
# 「主 provider」特殊分支已删除（`primary` 只是一个普通 provider 键名）。
# providers 读取顺序：env DPIM_PROVIDERS（最高优先）→ dpim.json 的 providers 段。
# 日常配置请走 WebUI「维护 → 运行配置」的提供商卡片（写入 dpim.json providers 段，重启保留）。
# DPIM_PROVIDERS='{"siliconflow": {"base_url": "https://api.siliconflow.cn/v1", "api_key": "sk-xxx", "model": "deepseek-ai/DeepSeek-V4-Flash"}}'
# 活动 provider：env → dpim.json → 注册表第一个键；显式指定但未登记时**原样保留**并如实报「未登记」
# DPIM_ACTIVE_PROVIDER=siliconflow

# 纯 env 种子（**仅当注册表为空且 DPIM_LLM_BASE_URL 显式设置**时，才合成一个名为 default 的 provider 条目，
# 以保住纯 env 部署）；其中 DPIM_LLM_API_KEY / DPIM_LLM_MODEL_NAME 只用于该种子条目：
# DPIM_LLM_BASE_URL=https://api.siliconflow.cn/v1
# DPIM_LLM_API_KEY=sk-xxx
# DPIM_LLM_MODEL_NAME=deepseek-ai/DeepSeek-V4-Flash

# 以下四项只是**全局调优兜底**（仅 env；provider 条目省略对应项时使用），既不是身份配置，
# 也不再属于 PUT /settings 的字段：
# 请求超时秒数（默认 666）
# DPIM_LLM_TIMEOUT=666
# 单次回复 token 上限（默认 0 = 不限制）
# DPIM_LLM_MAX_TOKENS=0
# 是否启用思考模式（默认未设置 = 交给 provider 决定）
# DPIM_LLM_ENABLE_THINKING=true
# 思考预算 token（默认 0 = 不限制）
# DPIM_LLM_THINKING_BUDGET=0
