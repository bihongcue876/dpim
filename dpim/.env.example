# DPIM 配置示例 — 复制为 .env 使用（.env 已被 gitignore，不进版本库）
# 标量系统配置放这里；BYOK 提供商 / Agent 结构化配置放 dpim.json（同目录）

# 存储路径
DPIM_MEMORY_DB_PATH=./data/memory.db
DPIM_GRAPH_JSON_PATH=./data/graph.json

# LLM 主 provider（primary 兜底；BYOK 多 provider 通常配在 dpim.json）
DPIM_LLM_BASE_URL=http://localhost:11434/v1
DPIM_LLM_API_KEY=
DPIM_LLM_MODEL_NAME=llama3:8b
# 生成请求超时（秒）：本地模型慢，默认已放宽到 300；provider 条目可单独覆盖
DPIM_LLM_TIMEOUT=300

# ── 厂商适配全局默认（provider 条目可单独覆盖；空/0 = 不干预）──
# DPIM_LLM_MAX_TOKENS=0          # 输出 token 上限（0 = 服务端默认）
# DPIM_LLM_ENABLE_THINKING=      # 思考开关：true / false / 空=服务端默认
# DPIM_LLM_THINKING_BUDGET=0     # 思考预算 tokens（0 = 不设）

# 结构化输出模式：md_json（默认，兼容 llama.cpp）| json | tools
# DPIM_LLM_STRUCTURED_MODE=md_json

# 上下文护栏：单次 LLM 输入中 raw_content 最大字符数（超限截断）
# DPIM_MAX_RAW_CONTENT=10000

# 检索参数
DPIM_MAX_GRAPH_HOPS=2
DPIM_RRF_K=60
DPIM_JACCARD_THRESHOLD=0.85

# 系统
DPIM_HEALTH_CHECK_INTERVAL=60
# 健康检查超时（秒）：与生成超时分离，模型加载/单槽忙碌时不至于 3 连败假降级
DPIM_HEALTH_CHECK_TIMEOUT=60
DPIM_COMPENSATE_BATCH_SIZE=20
DPIM_LOG_LEVEL=INFO

# ── 以下为可选项：env 可覆盖 dpim.json（一般不必设，结构化配置放 dpim.json）──
# DPIM_PROVIDERS={"qwen": {"base_url": "http://localhost:5091/v1", "api_key": "1", "models": ["m1", "m2"], "timeout": 300, "enable_thinking": true, "thinking_budget": 2048, "thinking_style": "top_level", "max_tokens": 4096, "structured_mode": "md_json"}}
# DPIM_ACTIVE_PROVIDER=qwen
# DPIM_ACTIVE_MODEL=m1
# DPIM_AGENT_MODE=pipeline
# DPIM_AGENT_MAX_RETRIES=2
# DPIM_AGENT_CR_MODEL=
# DPIM_AGENT_IN_MODEL=
# DPIM_AGENT_GR_MODEL=
# DPIM_AGENT_META_MODEL=

