# Python 字节码与缓存（递归覆盖所有子目录，含 controller/tools 等）
**/__pycache__/
*.py[cod]

# 虚拟环境
dpim/.venv/

# 工具缓存（ruff、mypy、pytest）
dpim/.ruff_cache/
dpim/.mypy_cache/
dpim/.pytest_cache/

# 打包产物
dpim/build/
dpim/dist/
dpim/*.egg-info/

# 代码覆盖率（后续使用）
dpim/.coverage
dpim/htmlcov/

# 环境变量（含 API Key）
dpim/.env
# .env 备份（本地部署文件，不入库；`.env.example` 是模板，照常入库）
dpim/.env.bak*

# 结构化配置（含 API Key，前端改配置写回此文件）
dpim/dpim.json
# 本地配置的备份（含明文密钥，绝不入库；dpim.json.bak-* 等）
dpim/dpim.json.*

# 运行期存储文件（SQLite + JSON 图谱）
dpim/data/

# 本地日志（前后端分文件，按天轮转）
dpim/logs/

# 前端项目
dpimWebUI/node_modules/
dpimWebUI/dist/

# 根目录游离的 npm 残留（真实前端项目在 dpimWebUI/）
/package.json
/package-lock.json

# TypeScript 增量构建缓存
dpimWebUI/*.tsbuildinfo

# CLI 工具
dpimCLI/**/__pycache__/
dpimCLI/**/*.py[cod]
dpimCLI/**/*.egg-info/
dpimCLI/**/.ruff_cache/
dpimCLI/**/.mypy_cache/
dpimCLI/**/.pytest_cache/
dpimCLI/**/.coverage
dpimCLI/**/htmlcov/
dpimCLI/build/
dpimCLI/dist/

# 测试临时目录（沙箱环境下 pytest basetemp / conftest tmp_path 重定向）
dpim/.pytest_tmp/
.pytest_tmp/
dpim/tests/.pytest_tmp_ws/

docs/
.workbuddy

# 发布产物（可下载/可分发的已打包交付物，不入库）
/release/

# Agent 本地协作引导（仅本地使用，不入库）
AGENTS.md
# AGENTS 历史分派表归档（本机文件，AGENTS.md 超指令预算后拆出）
/AGENTS-历史分派表.md

.dsh-vision-toolkit/

# 本地数据副本（用户图数据的保护性留档，属数据不属代码，绝不入库）
/graph-PROTECTED-*.json

# 一次性探针脚本（历史遗留的本机工具，文件自身即写明「用完即删；不属于交付物」）
/covplugin.py