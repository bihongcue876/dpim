# Python 字节码与缓存
dpim/__pycache__/
dpim/*.py[cod]
dpim/interface/__pycache__/
dpim/core/__pycache__/
dpim/tests/__pycache__/
dpim/controller/__pycache__/

# 虚拟环境
dpim/.venv/

# 工具缓存（ruff、mypy、pytest）
dpim/.ruff_cache/
dpim/.mypy_cache/
dpim/.pytest_cache/

# 打包产物
dpim/build/
dpim/dist/
dpim/*.egg-info/

# 代码覆盖率（后续使用）
dpim/.coverage
dpim/htmlcov/

# 环境变量（含 API Key）
dpim/.env

# 运行期存储文件（SQLite + JSON 图谱）
dpim/data/

# 前端项目
dpimWebUI/node_modules/
dpimWebUI/dist/

docs/


